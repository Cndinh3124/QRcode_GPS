# Khu vuc AWS va ten nhom tai nguyen.
aws_region        = "ap-southeast-1"
project_name      = "qr-event"
# De chay thu nghiem khong TLS, dung dev.
# Production bat buoc khai bao domain_name va route53_zone_id.
environment       = "dev"

# Cau hinh may ung dung va may co so du lieu.
instance_type     = "t3.small"
db_instance_class = "db.t3.micro"
db_name           = "qr_event_checkin"

# Dien ca hai gia tri neu muon dung ten mien va HTTPS.
# Ten mien phai nam trong public hosted zone cua Route 53.
domain_name     = ""
route53_zone_id = ""

# Bat Multi-AZ neu can du phong; tuy chon nay tang chi phi.
rds_multi_az = false

# Giu hai gia tri nay cho moi truong co du lieu can bao ve.
rds_deletion_protection = true
rds_skip_final_snapshot = false
